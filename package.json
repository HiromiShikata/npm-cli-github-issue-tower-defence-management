{
  "name": "github-issue-tower-defence-management",
  "version": "2.25.0",
  "description": "",
  "main": "bin/index.js",
  "scripts": {
    "prebuild": "npm run doctor && npm run build:console-ui",
    "doctor:node-version": "check-node-version --node 24 --npx 11 --npm 11",
    "doctor": "npm run doctor:node-version",
    "prettier": "prettier --write '**/*'",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "fmt": "npm run prettier && npm run lint-fix",
    "build:console-ui": "vite build --config src/adapter/entry-points/console/ui/vite.config.ts",
    "build": "tsc -p ./tsconfig.build.json",
    "postbuild": "node scripts/copyConsoleUiDist.mjs",
    "console-ui:lint": "biome check src/adapter/entry-points/console/ui",
    "console-ui:e2e:typecheck": "tsc --noEmit -p src/adapter/entry-points/console/ui/e2e/tsconfig.json",
    "console-ui:e2e": "npm run build:console-ui && playwright test --config src/adapter/entry-points/console/ui/e2e/playwright.config.ts",
    "console-ui:storybook": "storybook dev -p 6006 -c src/adapter/entry-points/console/ui/.storybook",
    "console-ui:build-storybook": "storybook build -c src/adapter/entry-points/console/ui/.storybook -o src/adapter/entry-points/console/ui/storybook-static",
    "test": "jest",
    "prepare": "true"
  },
  "bin": {
    "github-issue-tower-defence-management": "bin/adapter/entry-points/cli/index.js"
  },
  "types": "types/index.d.ts",
  "files": [
    "bin",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiromiShikata/npm-cli-github-issue-tower-defence-management.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HiromiShikata/npm-cli-github-issue-tower-defence-management/issues"
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "revert",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true,
          "provenance": true
        }
      ]
    ],
    "branches": [
      "main"
    ]
  },
  "homepage": "https://github.com/HiromiShikata/npm-cli-github-issue-tower-defence-management#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "check-node-version": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.8",
    "storybook": "^10.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "file:./lib/typescript-compat",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "^15.0.0",
    "dompurify": "3.4.14",
    "dotenv": "^17.4.2",
    "gemoji": "8.1.0",
    "googleapis": "^176.0.0",
    "ky": "^2.0.2",
    "marked": "18.0.10",
    "marked-emoji": "2.0.3",
    "playwright": "1.62.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "buffer-equal-constant-time": "file:./lib/buffer-equal-constant-time-compat"
  }
}
